# PUBLIC_INTERFACE
# Frontend environment variables for configuring the backend API and refresh interval.
# Copy this file to `.env` and adjust values per environment.

# Base URL of the Flask backend (no trailing slash).
# Examples:
# - Local dev: http://localhost:3001
# - In containerized preview: https://vscode-internal-XXXX-qa.qa01.cloud.kavia.ai:3001
REACT_APP_BEAR_API_URL=http://localhost:3001

# Auto-refresh interval in seconds. Set 0 to disable auto-refresh.
REACT_APP_REFRESH_INTERVAL_SECONDS=10

# IMPORTANT:
# Do not use duplicated variable names like REACT_APP_REACT_APP_BEAR_API_URL or
# REACT_APP_REACT_APP_REFRESH_INTERVAL_SECONDS — these are ignored by the codebase.
