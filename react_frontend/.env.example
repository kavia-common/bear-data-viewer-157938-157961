# PUBLIC_INTERFACE
# React frontend environment variables required for API access.
# Only these variables are read by the code. Do NOT prefix them twice.
# Example:
#   REACT_APP_BEAR_API_URL=http://localhost:3001
#   REACT_APP_REFRESH_INTERVAL_SECONDS=10

# URL of the Flask backend (no trailing slash). Use http or https consistently with your site.
REACT_APP_BEAR_API_URL=http://localhost:3001

# Auto-refresh interval in seconds (0 disables auto refresh)
REACT_APP_REFRESH_INTERVAL_SECONDS=10
