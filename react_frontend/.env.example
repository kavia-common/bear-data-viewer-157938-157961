# Example environment configuration for the React frontend.
# Copy this file to .env and adjust values as needed.

# Base URL of the Bear backend API (no trailing slash).
# The app will append "/api" automatically if not present.
# If not set, the app falls back to:
#   window.location.origin (replace :3000 with :3001) + "/api"
# and logs a console.warn.
REACT_APP_BEAR_API_URL=https://your-backend-host:3001

# Auto-refresh interval in seconds (set to 0 to disable auto-refresh)
REACT_APP_REFRESH_INTERVAL_SECONDS=10
